# Copy to .env.local and fill in. Never commit .env.local.

# Required for the partner assistant (Claude API). Get one at https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional: every lead (marketing + partner) is POSTed here as JSON,
# e.g. a Zapier/Make webhook that creates a monday.com item or emails the team.
LEADS_WEBHOOK_URL=

# Optional: Maia's booking link, offered to partners after they apply.
MAIA_BOOKING_URL=
